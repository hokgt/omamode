#!/usr/bin/env bash
# managed-by: omamode
# Steam's launcher entry runs this. It sends Steam launches through omamode
# (which offers gaming mode in work mode), and falls back to Steam itself if
# omamode has been removed, so Steam always keeps working.
cli=@PLUGIN_CLI@
if [[ -x "$cli" ]]; then
  exec "$cli" steam "$@"
fi
exec @STEAM_BIN@ "$@"
